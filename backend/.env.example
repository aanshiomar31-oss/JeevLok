# ==============================================================================
# ClinicalPulse AI — Backend Environment Variables
# ==============================================================================
# Copy this file to `.env` in the same directory (backend/.env) and adjust
# values for your machine. `.env` is gitignored — never commit real secrets.
#
#   cp .env.example .env
# ==============================================================================

# --- General -------------------------------------------------------------------
PROJECT_NAME="ClinicalPulse AI"
ENVIRONMENT=development
DEBUG=true

# --- Security ------------------------------------------------------------------
# Generate a real value for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_ME_INSECURE_DEV_ONLY_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database --------------------------------------------------------------------
# Default: local SQLite file under backend/data/. Override for Postgres etc.
DATABASE_URL=sqlite:///./data/patient_triage.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/patient_triage

# --- CORS ----------------------------------------------------------------------
# JSON array of allowed frontend origins.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- GenAI, LLM & Voice Transcription (Optional) -------------------------------
# The system operates out-of-the-box in local offline mode (zero API keys needed).
# To enable cloud LLMs and Whisper transcription, configure:
# LLM_PROVIDER=local  # local | openai | gemini
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# --- MLflow ----------------------------------------------------------------------
# MLFLOW_TRACKING_URI=file:./reports/mlruns
MLFLOW_EXPERIMENT_NAME=clinicalpulse_ai

# --- Logging ---------------------------------------------------------------------
LOG_LEVEL=INFO

